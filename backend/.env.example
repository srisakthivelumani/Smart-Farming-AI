# ══════════════════════════════════════════════════════════════════════════════
# Smart Farming AI — Environment Variable Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Smart Farming AI
APP_VERSION=1.0.0
DEBUG=false
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# ── IBM watsonx.ai — IBM Granite (MANDATORY) ──────────────────────────────────
# Obtain from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your-ibm-cloud-api-key-here

# Obtain from: watsonx.ai console → your project → Manage → General → Project ID
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# Dallas (us-south) endpoint — change only if your account is in a different region
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Active non-deprecated Granite model for direct inference on IBM Cloud Lite.
# Current recommendation: ibm/granite-4-h-small (active as of 2026)
# Override here if IBM releases a newer model.
# DO NOT substitute a non-IBM model.
GRANITE_MODEL_ID=ibm/granite-4-h-small

# ── Granite inference parameters (all optional — defaults shown) ───────────────
GRANITE_MAX_NEW_TOKENS=512
GRANITE_MIN_NEW_TOKENS=10
GRANITE_TEMPERATURE=0.7
GRANITE_TOP_P=0.9
GRANITE_TOP_K=50
GRANITE_REPETITION_PENALTY=1.1

# ── RAG / Embeddings ──────────────────────────────────────────────────────────
# LaBSE: Language-Agnostic BERT Sentence Embeddings — 109 languages incl. Tamil
EMBEDDING_MODEL=sentence-transformers/LaBSE
FAISS_INDEX_PATH=data/faiss_index
DOCUMENTS_PATH=data/documents
SEED_DOCS_PATH=data/seed_docs
RAG_TOP_K=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── OpenWeatherMap (Phase 4) ───────────────────────────────────────────────────
# Obtain from: https://openweathermap.org/api  (free tier available)
# Leave blank until configured — the application will show "data unavailable".
OPENWEATHER_API_KEY=

# ── data.gov.in / Agmarknet Mandi Prices (Phase 5) ────────────────────────────
# Obtain from: https://data.gov.in  (free government open data)
# Leave blank until configured — the application will show "data unavailable".
DATAGOV_API_KEY=

# ── Cache TTLs ────────────────────────────────────────────────────────────────
WEATHER_CACHE_TTL_SECONDS=600
MANDI_CACHE_TTL_SECONDS=3600
